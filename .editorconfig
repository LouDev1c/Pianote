# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# C# files
[*.cs]
indent_style = space
indent_size = 4

# Godot scene/resource/project files
[*.{tscn,tres,godot,cfg}]
indent_style = tab
indent_size = 4

# GDScript files, if used later
[*.gd]
indent_style = tab
indent_size = 4

# Python files
[*.py]
indent_style = space
indent_size = 4

# JSON / YAML / Markdown
[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

# Windows scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf